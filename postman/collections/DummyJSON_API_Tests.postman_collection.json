    {
      "name": "02 - Products",
      "description": "Products read and simulated write scenarios. No authentication required. POST/PUT/DELETE do not persist on DummyJSON.",
      "item": [
        {
          "name": "GET Products - Default List",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const response = pm.response.json();",
                  "",
                  "const productListSchema = {",
                  "    type: 'object',",
                  "    required: ['products', 'total', 'skip', 'limit'],",
                  "    properties: {",
                  "        products: { type: 'array', minItems: 1 },",
                  "        total: { type: 'number' },",
                  "        skip: { type: 'number' },",
                  "        limit: { type: 'number' }",
                  "    },",
                  "    additionalProperties: true",
                  "};",
                  "",
                  "pm.test('Product catalog is returned successfully', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Product list matches the expected collection contract', function () {",
                  "    pm.response.to.have.jsonSchema(productListSchema);",
                  "",
                  "    const firstProduct = response.products[0];",
                  "    pm.expect(firstProduct.id).to.be.a('number');",
                  "    pm.expect(firstProduct.title).to.be.a('string').and.not.empty;",
                  "    pm.expect(firstProduct.price).to.be.a('number');",
                  "    pm.expect(firstProduct.category).to.be.a('string').and.not.empty;",
                  "});",
                  "",
                  "if (",
                  "    pm.response.code === 200 &&",
                  "    Array.isArray(response.products) &&",
                  "    response.products.length > 0 &&",
                  "    typeof response.products[0].id === 'number'",
                  ") {",
                  "    pm.environment.set('productId', String(response.products[0].id));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products"
              ]
            },
            "description": "Returns the default product list and stores productId from the first item only when the response is successful."
          },
          "response": []
        },
