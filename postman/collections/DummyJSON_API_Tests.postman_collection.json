        {
          "name": "GET Current User - Missing Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const previousAccessToken = pm.environment.get('accessToken');",
                  "const previousRefreshToken = pm.environment.get('refreshToken');",
                  "const previousAuthUserId = pm.environment.get('authUserId');",
                  "const response = pm.response.json();",
                  "",
                  "const errorSchema = {",
                  "    type: 'object',",
                  "    required: ['message'],",
                  "    properties: {",
                  "        message: { type: 'string', minLength: 1 }",
                  "    },",
                  "    additionalProperties: true",
                  "};",
                  "",
                  "pm.test('Current user is denied without an access token', function () {",
                  "    pm.response.to.have.status(401);",
                  "});",
                  "",
                  "pm.test('Error response requires an access token', function () {",
                  "    pm.response.to.have.jsonSchema(errorSchema);",
                  "    pm.expect(response.message).to.eql('Access Token is required');",
                  "});",
                  "",
                  "pm.test('Unauthorized request does not change stored session data', function () {",
                  "    pm.expect(pm.environment.get('accessToken')).to.eql(previousAccessToken);",
                  "    pm.expect(pm.environment.get('refreshToken')).to.eql(previousRefreshToken);",
                  "    pm.expect(pm.environment.get('authUserId')).to.eql(previousAuthUserId);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
