          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const previousProductId = pm.environment.get('productId');",
                  "const response = pm.response.json();",
                  "",
                  "const createdProductSchema = {",
