                  "    },",
                  "    additionalProperties: true",
                  "};",
                  "",
                  "pm.test('Current user is denied for an invalid access token', function () {",
                  "    pm.response.to.have.status(500);",
                  "});",
                  "",
                  "pm.test('Error response reports an invalid token', function () {",
                  "    pm.response.to.have.jsonSchema(errorSchema);",
                  "    pm.expect(response.message).to.eql('invalid token');",
                  "});",
                  "",
                  "pm.test('Unauthorized request does not change stored session data', function () {",
                  "    pm.expect(pm.environment.get('accessToken')).to.eql(previousAccessToken);",
                  "    pm.expect(pm.environment.get('refreshToken')).to.eql(previousRefreshToken);",
